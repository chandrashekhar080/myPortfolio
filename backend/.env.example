# Copy this file to backend/.env and fill in real values.
# NEVER put real credentials in this file — it is committed to git.

# Server
PORT=5000
NODE_ENV=development

# Mongo — local install or an Atlas connection string.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Auth. Production refuses to start on the placeholder or on anything under 32
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API.
# In production list the deployed frontend and admin URLs, with no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Public base URL of this API — used to build absolute URLs for uploaded images.
# Must be the API's OWN address, with no trailing slash and no `/api` suffix.
# Leaving the localhost value in production makes every uploaded image 404 in
# the browser, so on Render set it to the service URL:
#   PUBLIC_URL=https://myportfolio-backend-c8pg.onrender.com
PUBLIC_URL=http://localhost:5000

# Seeded admin account (npm run seed).
# dotenv treats an unquoted `#` as the start of a comment, so wrap any password
# containing punctuation in double quotes or it will be silently truncated.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="change-me-before-seeding"
ADMIN_NAME=Site Admin
