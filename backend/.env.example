# Server
PORT=5000
NODE_ENV=development

# Mongo — local install or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Auth. Change JWT_SECRET to a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174

# Public base URL of this API — used to build absolute upload URLs
PUBLIC_URL=http://localhost:5000

# Seeded admin account (npm run seed)
ADMIN_EMAIL=0810chandrashekhar@gmail.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Chandrashekhar Ghosh
