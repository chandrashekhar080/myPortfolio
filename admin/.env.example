# Base URL of the API — no trailing slash, and no `/api` suffix.
# The app appends `/api/...` itself; a value ending in `/api` is stripped
# automatically so an old setting can't produce `/api/api/...`.
#
# Local development:
VITE_API_URL=http://localhost:5000
#
# Production (set in Netlify → Site settings → Environment variables, or leave
# netlify.toml to supply it):
VITE_API_URL=https://myportfolio-backend-c8pg.onrender.com

# Public URL of the portfolio site, linked to from the admin header.
VITE_SITE_URL=http://localhost:8080
#Production: VITE_SITE_URL=https://shekharmyportfolio.netlify.app
